{
    "name": "marcelofecchio/correios-api",
    "description": "Componente PHP para a API REST dos Correios (CWS) e para gerar etiquetas em ZPL.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "correios",
        "cws",
        "pre-postagem",
        "rastreamento",
        "etiqueta",
        "zpl",
        "danfe",
        "laravel"
    ],
    "authors": [
        {
            "name": "Marcelo Fecchio"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-dom": "*",
        "ext-json": "*",
        "ext-libxml": "*",
        "ext-mbstring": "*",
        "php-http/discovery": "^1.19",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0",
        "psr/log": "^2.0 || ^3.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "guzzlehttp/guzzle": "^7.9 || ^8.0",
        "illuminate/support": "^12.0 || ^13.0",
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^3.0 || ^4.0",
        "php-http/mock-client": "^1.6",
        "phpstan/phpstan": "^2.0"
    },
    "suggest": {
        "guzzlehttp/guzzle": "Cliente HTTP PSR-18 recomendado (permite configurar o timeout).",
        "ext-gd": "Necessária só para converter imagens em ^GFA (Etiquetas\\ImagemZpl).",
        "ext-zlib": "Necessária só para gerar ^GFA no formato :Z64: (Etiquetas\\ImagemZpl).",
        "illuminate/support": "Integração opcional com o Laravel (ServiceProvider e Facade)."
    },
    "autoload": {
        "psr-4": {
            "MarceloFecchio\\Correios\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MarceloFecchio\\Correios\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "MarceloFecchio\\Correios\\Laravel\\CorreiosServiceProvider"
            ],
            "aliases": {
                "Correios": "MarceloFecchio\\Correios\\Laravel\\Facades\\Correios"
            }
        }
    },
    "scripts": {
        "test": "pest",
        "test:cobertura": "pest --coverage --min=90",
        "analise": "phpstan analyse --memory-limit=1G",
        "estilo": "php-cs-fixer fix --dry-run --diff",
        "estilo:corrigir": "php-cs-fixer fix",
        "qualidade": [
            "@composer validate --strict",
            "@estilo",
            "@analise",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": false,
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
